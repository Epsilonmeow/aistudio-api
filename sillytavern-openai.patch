diff --git a/src/aistudio_api/api/routes_openai.py b/src/aistudio_api/api/routes_openai.py
new file mode 100644
index 0000000000000000000000000000000000000000..c1e8a857030ceb13cb0ebd3922f9d264d2b9f225
--- /dev/null
+++ b/src/aistudio_api/api/routes_openai.py
@@ -0,0 +1,337 @@
+"""Text-only OpenAI compatibility over the existing Gemini request lifecycle."""
+
+from __future__ import annotations
+
+import json
+import time
+import uuid
+from collections.abc import AsyncGenerator, Mapping
+from typing import Literal
+
+from fastapi import APIRouter, Depends, HTTPException
+from fastapi.responses import JSONResponse, StreamingResponse
+from pydantic import BaseModel, Field, field_validator
+
+from aistudio_api.application.api_service_gemini import (
+    classify_gemini_error_payload,
+    handle_gemini_generate_content,
+)
+from aistudio_api.infrastructure.gateway.client import AIStudioClient
+from aistudio_api.infrastructure.gateway.model_discovery import model_discovery
+
+from .dependencies import get_client, get_runtime_state
+from .response_models import GeminiGenerateContentResponse, GeminiUsageMetadata
+from .schemas import (
+    GeminiContent,
+    GeminiGenerateContentRequest,
+    GeminiGenerationConfig,
+    GeminiPart,
+)
+from .state import RuntimeState
+
+router = APIRouter(prefix="/v1")
+
+
+class TextPart(BaseModel):
+    type: Literal["text"]
+    text: str
+
+
+class ChatMessage(BaseModel):
+    role: Literal["system", "developer", "user", "assistant"]
+    content: str | list[TextPart]
+    tool_calls: list[object] = Field(default_factory=list, max_length=0)
+    function_call: None = None
+
+
+class StreamOptions(BaseModel):
+    include_usage: bool = False
+
+
+class ChatRequest(BaseModel):
+    model: str = Field(min_length=1, max_length=200)
+    messages: list[ChatMessage] = Field(min_length=1)
+    stream: bool = False
+    stream_options: StreamOptions | None = None
+    temperature: float | None = Field(default=None, ge=0, le=2)
+    top_p: float | None = Field(default=None, ge=0, le=1)
+    max_tokens: int | None = Field(default=None, gt=0)
+    max_completion_tokens: int | None = Field(default=None, gt=0)
+    stop: str | list[str] | None = None
+    n: Literal[1] = 1
+    tools: list[object] = Field(default_factory=list, max_length=0)
+    functions: list[object] = Field(default_factory=list, max_length=0)
+    tool_choice: Literal["none"] | None = None
+    function_call: Literal["none"] | None = None
+    response_format: dict[str, object] | None = None
+
+    @field_validator("model")
+    @classmethod
+    def validate_model(cls, value: str) -> str:
+        value = value.strip().removeprefix("models/")
+        if not value:
+            raise ValueError("model must not be empty")
+        return value
+
+    @field_validator("response_format")
+    @classmethod
+    def validate_response_format(
+        cls, value: dict[str, object] | None
+    ) -> dict[str, object] | None:
+        if value is not None and value != {"type": "text"}:
+            raise ValueError("Only text response_format is supported")
+        return value
+
+
+def openai_error_payload(message: str, code: int) -> dict[str, object]:
+    error_type = (
+        "authentication_error"
+        if code in (401, 403)
+        else "rate_limit_error"
+        if code == 429
+        else "server_error"
+        if code >= 500
+        else "invalid_request_error"
+    )
+    return {
+        "error": {"message": message, "type": error_type, "param": None, "code": code}
+    }
+
+
+def openai_error_response(exc: HTTPException) -> JSONResponse:
+    code, message, _ = classify_gemini_error_payload(exc)
+    return JSONResponse(
+        status_code=code,
+        content=openai_error_payload(message, code),
+        headers=exc.headers,
+    )
+
+
+def _is_text_model(model: Mapping[str, object]) -> bool:
+    name = str(model.get("id") or model.get("name") or "").lower()
+    return not any(
+        model.get(flag)
+        for flag in ("is_image_model", "is_video_model", "is_audio_model")
+    ) and not any(
+        word in name
+        for word in ("image", "imagen", "banana", "veo", "lyria", "tts", "transcribe")
+    )
+
+
+@router.get("/models")
+async def list_models(
+    runtime_state: RuntimeState = Depends(get_runtime_state),
+) -> dict[str, object]:
+    session = runtime_state.client.session if runtime_state.client else None
+    models = await model_discovery.get_models(session=session)
+    return {
+        "object": "list",
+        "data": [
+            {
+                "id": str(model.get("id") or model.get("name") or "").removeprefix(
+                    "models/"
+                ),
+                "object": "model",
+                "created": 0,
+                "owned_by": "google",
+            }
+            for model in models
+            if _is_text_model(model)
+        ],
+    }
+
+
+def to_gemini_request(req: ChatRequest) -> GeminiGenerateContentRequest:
+    contents: list[GeminiContent] = []
+    instructions: list[GeminiPart] = []
+    for message in req.messages:
+        text = (
+            message.content
+            if isinstance(message.content, str)
+            else "".join(part.text for part in message.content)
+        )
+        parts = [GeminiPart(text=text)]
+        if message.role in ("system", "developer"):
+            instructions.extend(parts)
+            continue
+        role = "model" if message.role == "assistant" else "user"
+        if contents and contents[-1].role == role:
+            contents[-1].parts.extend(parts)
+        else:
+            contents.append(GeminiContent(role=role, parts=parts))
+    if not contents or not any(item.role == "user" for item in contents):
+        raise HTTPException(400, detail="messages must include a user message")
+    if contents[-1].role == "model":
+        # AI Studio rejects model-final histories. Preserve them and request continuation;
+        # this is not exact assistant-prefix completion, which the upstream cannot provide.
+        contents.append(
+            GeminiContent(
+                role="user",
+                parts=[
+                    GeminiPart(
+                        text="Continue according to the instructions and requested output format above."
+                    )
+                ],
+            )
+        )
+    stop = [req.stop] if isinstance(req.stop, str) else req.stop
+    return GeminiGenerateContentRequest(
+        contents=contents,
+        systemInstruction=GeminiContent(parts=instructions) if instructions else None,
+        # An explicit empty list prevents configured search/tool defaults in this text-only API.
+        tools=[],
+        generationConfig=GeminiGenerationConfig(
+            temperature=req.temperature,
+            topP=req.top_p,
+            maxOutputTokens=req.max_completion_tokens
+            if req.max_completion_tokens is not None
+            else req.max_tokens,
+            stopSequences=stop,
+        ),
+    )
+
+
+def _finish_reason(reason: str | None) -> str:
+    if reason == "MAX_TOKENS":
+        return "length"
+    if reason in (
+        "SAFETY",
+        "RECITATION",
+        "BLOCKLIST",
+        "PROHIBITED_CONTENT",
+        "SPII",
+        "IMAGE_SAFETY",
+    ):
+        return "content_filter"
+    return "stop"
+
+
+def _usage(usage: GeminiUsageMetadata | None) -> dict[str, object]:
+    usage = usage or GeminiUsageMetadata()
+    return {
+        "prompt_tokens": usage.promptTokenCount,
+        "completion_tokens": usage.candidatesTokenCount,
+        "total_tokens": usage.totalTokenCount,
+        "completion_tokens_details": {"reasoning_tokens": usage.thoughtsTokenCount},
+        "prompt_tokens_details": {"cached_tokens": usage.cachedContentTokenCount or 0},
+    }
+
+
+def _visible_text(response: GeminiGenerateContentResponse) -> str:
+    return "".join(
+        part.text
+        for candidate in response.candidates
+        for part in candidate.content.parts
+        if part.text and not part.thought
+    )
+
+
+def _sse(payload: dict[str, object]) -> str:
+    return "data: " + json.dumps(payload, ensure_ascii=False) + "\n\n"
+
+
+async def _stream_openai(
+    upstream: StreamingResponse,
+    *,
+    model: str,
+    completion_id: str,
+    created: int,
+    include_usage: bool,
+) -> AsyncGenerator[str, None]:
+    base: dict[str, object] = {
+        "id": completion_id,
+        "object": "chat.completion.chunk",
+        "created": created,
+        "model": model,
+    }
+
+    def chunk(delta: dict[str, str], finish_reason: str | None = None) -> str:
+        return _sse(
+            {
+                **base,
+                "choices": [
+                    {"index": 0, "delta": delta, "finish_reason": finish_reason}
+                ],
+                **({"usage": None} if include_usage else {}),
+            }
+        )
+
+    iterator = upstream.body_iterator.__aiter__()
+    try:
+        yield chunk({"role": "assistant", "content": ""})
+        finished = False
+        async for event in iterator:
+            # Internal Gemini iterator yields one complete SSE event per item; no HTTP re-request.
+            text = event if isinstance(event, str) else bytes(event).decode("utf-8")
+            payload = json.loads(text.removeprefix("data: ").strip())
+            if "error" in payload:
+                error = payload["error"]
+                yield _sse(
+                    openai_error_payload(str(error["message"]), int(error["code"]))
+                )
+                yield "data: [DONE]\n\n"
+                return
+            response = GeminiGenerateContentResponse.model_validate(payload)
+            content = _visible_text(response)
+            if content:
+                yield chunk({"content": content})
+            for candidate in response.candidates:
+                if candidate.finishReason:
+                    yield chunk({}, _finish_reason(candidate.finishReason))
+                    finished = True
+            if response.usageMetadata and include_usage:
+                yield _sse(
+                    {**base, "choices": [], "usage": _usage(response.usageMetadata)}
+                )
+        if not finished:
+            yield _sse(
+                openai_error_payload("Upstream stream ended without a completion", 502)
+            )
+        yield "data: [DONE]\n\n"
+    finally:
+        close = getattr(iterator, "aclose", None)
+        if close is not None:
+            await close()
+
+
+@router.post("/chat/completions", response_model=None)
+async def chat_completions(
+    req: ChatRequest,
+    client: AIStudioClient = Depends(get_client),
+) -> dict[str, object] | StreamingResponse:
+    gemini_req = to_gemini_request(req)
+    completion_id = "chatcmpl-" + uuid.uuid4().hex
+    created = int(time.time())
+    response = await handle_gemini_generate_content(
+        req.model, gemini_req, client, stream=req.stream
+    )
+    if isinstance(response, StreamingResponse):
+        return StreamingResponse(
+            _stream_openai(
+                response,
+                model=req.model,
+                completion_id=completion_id,
+                created=created,
+                include_usage=bool(
+                    req.stream_options and req.stream_options.include_usage
+                ),
+            ),
+            media_type="text/event-stream",
+            headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
+        )
+    return {
+        "id": completion_id,
+        "object": "chat.completion",
+        "created": created,
+        "model": req.model,
+        "choices": [
+            {
+                "index": 0,
+                "message": {"role": "assistant", "content": _visible_text(response)},
+                "finish_reason": _finish_reason(
+                    response.candidates[0].finishReason if response.candidates else None
+                ),
+            }
+        ],
+        "usage": _usage(response.usageMetadata),
+    }
