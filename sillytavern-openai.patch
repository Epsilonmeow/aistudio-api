@@ -0,0 +1,358 @@
+"""Exercise the HTTP compatibility boundary without Google credentials or network."""
+
+import json
+from unittest.mock import AsyncMock
+
+import httpx
+import pytest
+from fastapi import HTTPException
+from fastapi.responses import StreamingResponse
+
+from aistudio_api.api import routes_openai
+from aistudio_api.api.app import app
+from aistudio_api.api.dependencies import get_client
+from aistudio_api.api.response_models import GeminiGenerateContentResponse
+from aistudio_api.application.api_service_gemini import (
+    format_sse_error,
+    format_sse_event,
+    format_sse_usage,
+)
+from aistudio_api.config import settings
+
+
+@pytest.fixture
+def client_stub(monkeypatch):
+    monkeypatch.setattr(settings, "api_keys", frozenset())
+    stub = object()
+    app.dependency_overrides[get_client] = lambda: stub
+    yield stub
+    app.dependency_overrides.pop(get_client, None)
+
+
+def _client():
+    return httpx.AsyncClient(
+        transport=httpx.ASGITransport(app=app), base_url="http://test"
+    )
+
+
+def _payload(**kwargs):
+    return {
+        "model": "gemini-3.8-flash",
+        "messages": [{"role": "user", "content": "Hello"}],
+        **kwargs,
+    }
+
+
+def _gemini_reply():
+    return GeminiGenerateContentResponse.model_validate(
+        {
+            "candidates": [
+                {
+                    "content": {
+                        "parts": [
+                            {"text": "private reasoning", "thought": True},
+                            {"text": "你好"},
+                        ]
+                    },
+                    "finishReason": "MAX_TOKENS",
+                }
+            ],
+            "usageMetadata": {
+                "promptTokenCount": 10,
+                "candidatesTokenCount": 8,
+                "thoughtsTokenCount": 5,
+                "totalTokenCount": 18,
+            },
+        }
+    )
+
+
+@pytest.mark.asyncio
+async def test_models_json_for_browser_and_authentication(monkeypatch, client_stub):
+    monkeypatch.setattr(
+        routes_openai.model_discovery,
+        "get_models",
+        AsyncMock(
+            return_value=[
+                {"id": "models/text-model"},
+                {"id": "image-model", "is_image_model": True},
+                {"id": "audio-model", "is_audio_model": True},
+            ]
+        ),
+    )
+    monkeypatch.setattr(settings, "api_keys", frozenset({"test-secret"}))
+    async with _client() as client:
+        denied = await client.get("/v1/models")
+        assert denied.status_code == 401
+        assert denied.json()["error"]["type"] == "authentication_error"
+        result = await client.get(
+            "/v1/models",
+            headers={"Authorization": "Bearer test-secret", "Accept": "text/html"},
+        )
+        assert result.status_code == 200
+        assert result.headers["content-type"].startswith("application/json")
+        assert result.json() == {
+            "object": "list",
+            "data": [
+                {
+                    "id": "text-model",
+                    "object": "model",
+                    "created": 0,
+                    "owned_by": "google",
+                }
+            ],
+        }
+
+
+@pytest.mark.asyncio
+async def test_chat_maps_messages_parameters_reply_and_usage(monkeypatch, client_stub):
+    generate = AsyncMock(return_value=_gemini_reply())
+    monkeypatch.setattr(routes_openai, "handle_gemini_generate_content", generate)
+    request = _payload(
+        model="models/gemini-3.8-flash",
+        messages=[
+            {"role": "system", "content": "System instruction"},
+            {"role": "developer", "content": "Developer instruction"},
+            {"role": "user", "content": [{"type": "text", "text": "First"}]},
+            {"role": "user", "content": "Second"},
+            {"role": "assistant", "content": "Earlier answer"},
+            {"role": "user", "content": "Question"},
+        ],
+        temperature=0,
+        top_p=0.8,
+        max_tokens=100,
+        max_completion_tokens=200,
+        stop="END",
+    )
+    async with _client() as client:
+        result = await client.post("/v1/chat/completions", json=request)
+    assert result.status_code == 200
+    data = result.json()
+    assert data["object"] == "chat.completion"
+    assert data["choices"][0] == {
+        "index": 0,
+        "message": {"role": "assistant", "content": "你好"},
+        "finish_reason": "length",
+    }
+    assert data["usage"]["total_tokens"] == 18
+    assert data["usage"]["completion_tokens"] == 8
+    assert data["usage"]["completion_tokens_details"]["reasoning_tokens"] == 5
+    model, req, passed_client = generate.call_args.args
+    assert model == "gemini-3.8-flash"
+    assert passed_client is client_stub
+    assert generate.call_args.kwargs == {"stream": False}
+    assert [part.text for part in req.systemInstruction.parts] == [
+        "System instruction",
+        "Developer instruction",
+    ]
+    assert [content.role for content in req.contents] == ["user", "model", "user"]
+    assert [part.text for part in req.contents[0].parts] == ["First", "Second"]
+    assert req.tools == []
+    assert req.generationConfig.temperature == 0
+    assert req.generationConfig.maxOutputTokens == 200
+    assert req.generationConfig.stopSequences == ["END"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("stream", [False, True])
+async def test_assistant_tail_keeps_history_and_adds_user_turn(
+    monkeypatch, client_stub, stream
+):
+    async def generate(model, req, client, *, stream):
+        assert [item.role for item in req.contents] == ["user", "model", "user"]
+        assert req.contents[0].parts[0].text == "Return the requested table."
+        assert [part.text for part in req.contents[1].parts] == [
+            "Earlier answer",
+            "Table prefix",
+        ]
+        assert req.contents[-1].parts[0].text
+        if stream:
+
+            async def events():
+                yield format_sse_event("body", "TABLE_OK") or ""
+                yield format_sse_usage(
+                    {"prompt_tokens": 4, "completion_tokens": 2, "total_tokens": 6}
+                )
+
+            return StreamingResponse(events())
+        return _gemini_reply()
+
+    monkeypatch.setattr(routes_openai, "handle_gemini_generate_content", generate)
+    async with _client() as client:
+        response = await client.post(
+            "/v1/chat/completions",
+            json=_payload(
+                messages=[
+                    {"role": "user", "content": "Return the requested table."},
+                    {"role": "assistant", "content": "Earlier answer"},
+                    {"role": "assistant", "content": "Table prefix"},
+                ],
+                stream=stream,
+            ),
+        )
+    assert response.status_code == 200
+    if stream:
+        assert "TABLE_OK" in response.text
+        assert response.text.endswith("data: [DONE]\n\n")
+    else:
+        assert response.json()["choices"][0]["message"]["content"] == "你好"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("include_usage", [False, True])
+async def test_stream_keeps_id_separates_thoughts_finishes_and_reports_usage(
+    monkeypatch, client_stub, include_usage
+):
+    closed = []
+
+    async def events():
+        try:
+            yield format_sse_event("thinking", "private reasoning") or ""
+            yield format_sse_event("body", "你好") or ""
+            yield format_sse_event("body", "世界") or ""
+            yield format_sse_usage(
+                {"prompt_tokens": 4, "completion_tokens": 6, "total_tokens": 10}
+            )
+        finally:
+            closed.append(True)
+
+    monkeypatch.setattr(
+        routes_openai,
+        "handle_gemini_generate_content",
+        AsyncMock(return_value=StreamingResponse(events())),
+    )
+    async with _client() as client:
+        result = await client.post(
+            "/v1/chat/completions",
+            json=_payload(stream=True, stream_options={"include_usage": include_usage}),
+        )
+    assert result.status_code == 200
+    assert result.headers["content-type"].startswith("text/event-stream")
+    assert result.text.endswith("data: [DONE]\n\n")
+    frames = [
+        json.loads(line[6:])
+        for line in result.text.splitlines()
+        if line.startswith("data: {")
+    ]
+    assert len({frame["id"] for frame in frames}) == 1
+    assert len({frame["created"] for frame in frames}) == 1
+    assert frames[0]["choices"][0]["delta"]["role"] == "assistant"
+    assert (
+        "".join(
+            choice["delta"].get("content", "")
+            for frame in frames
+            for choice in frame["choices"]
+        )
+        == "你好世界"
+    )
+    finishes = [
+        choice["finish_reason"]
+        for frame in frames
+        for choice in frame["choices"]
+        if choice["finish_reason"]
+    ]
+    assert finishes == ["stop"]
+    if include_usage:
+        assert frames[-1]["choices"] == []
+        assert frames[-1]["usage"]["total_tokens"] == 10
+        assert all(frame["usage"] is None for frame in frames[:-1])
+    else:
+        assert all("usage" not in frame for frame in frames)
+    assert closed == [True]
+
+
+@pytest.mark.asyncio
+async def test_stream_error_does_not_report_success(monkeypatch, client_stub):
+    async def events():
+        yield format_sse_error(HTTPException(429, detail="quota exhausted"))
+
+    monkeypatch.setattr(
+        routes_openai,
+        "handle_gemini_generate_content",
+        AsyncMock(return_value=StreamingResponse(events())),
+    )
+    async with _client() as client:
+        result = await client.post("/v1/chat/completions", json=_payload(stream=True))
+    frames = [
+        json.loads(line[6:])
+        for line in result.text.splitlines()
+        if line.startswith("data: {")
+    ]
+    assert frames[-1]["error"]["type"] == "rate_limit_error"
+    assert frames[-1]["error"]["code"] == 429
+    assert all(
+        not choice["finish_reason"]
+        for frame in frames
+        for choice in frame.get("choices", [])
+    )
+
+
+@pytest.mark.asyncio
+async def test_stream_closes_upstream_when_consumer_disconnects():
+    closed = []
+
+    async def events():
+        try:
+            yield format_sse_event("body", "partial") or ""
+            raise AssertionError("Disconnected client must not consume more output")
+        finally:
+            closed.append(True)
+
+    stream = routes_openai._stream_openai(
+        StreamingResponse(events()),
+        model="test",
+        completion_id="test-id",
+        created=1,
+        include_usage=False,
+    )
+    await anext(stream)  # role
+    await anext(stream)  # first body
+    await stream.aclose()
+    assert closed == [True]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "change",
+    [
+        {"messages": []},
+        {
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [{"type": "image_url", "image_url": {"url": "example"}}],
+                }
+            ]
+        },
+        {"messages": [{"role": "tool", "content": "result"}]},
+        {"tools": [{"type": "function"}]},
+        {"n": 2},
+        {"model": "models/"},
+        {"max_tokens": 0},
+        {"response_format": {"type": "json_schema"}},
+    ],
+)
+async def test_unsupported_requests_fail_before_generation(
+    monkeypatch, client_stub, change
+):
+    generate = AsyncMock()
+    monkeypatch.setattr(routes_openai, "handle_gemini_generate_content", generate)
+    async with _client() as client:
+        response = await client.post("/v1/chat/completions", json=_payload(**change))
+    assert response.status_code == 400
+    assert response.json()["error"]["type"] == "invalid_request_error"
+    generate.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+async def test_generation_error_preserves_status(monkeypatch, client_stub):
+    monkeypatch.setattr(
+        routes_openai,
+        "handle_gemini_generate_content",
+        AsyncMock(side_effect=HTTPException(403, detail="permission denied")),
+    )
+    async with _client() as client:
+        response = await client.post("/v1/chat/completions", json=_payload())
+    assert response.status_code == 403
+    assert response.json()["error"]["message"] == "permission denied"
+    assert response.json()["error"]["type"] == "authentication_error"
